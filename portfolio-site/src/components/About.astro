---
import { siteConfig } from "../config";
---

<section id="about" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 2xl:grid-cols-12 gap-8 2xl:gap-16 items-start">
      <div class="2xl:col-span-4">
        <h2
          class="text-2xl sm:text-3xl md:text-4xl 2xl:text-5xl font-bold text-gray-900"
        >
          <span data-lang-en>{siteConfig.en.aboutMeTitle}</span>
          <span data-lang-es style="display:none">{siteConfig.es.aboutMeTitle}</span>
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>
      </div>

      <div class="2xl:col-span-8 space-y-8">
        <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-600">
          <span data-lang-en>{siteConfig.en.aboutMe}</span>
          <span data-lang-es style="display:none">{siteConfig.es.aboutMe}</span>
        </p>
      </div>
    </div>
  </div>
</section>
