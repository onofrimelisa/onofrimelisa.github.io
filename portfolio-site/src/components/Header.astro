---
import { siteConfig } from "../config";
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 hidden md:block transition-all duration-300"
>
  <nav class="max-w-7xl mx-auto px-8 py-4">
    <ul class="flex items-center gap-8 justify-center">
      <li>
        <a
          href="#about"
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          <span data-lang-en>About</span>
          <span data-lang-es style="display:none">Sobre Mí</span>
        </a>
      </li>
      <li>
        <a
          href="#skills"
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          <span data-lang-en>Skills</span>
          <span data-lang-es style="display:none">Skills</span>
        </a>
      </li>
      <li>
        <a
          href="#experience"
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          <span data-lang-en>Experience</span>
          <span data-lang-es style="display:none">Experiencia</span>
        </a>
      </li>
      <li>
        <a
          href="#education"
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          <span data-lang-en>Education</span>
          <span data-lang-es style="display:none">Educación</span>
        </a>
      </li>
      <li>
        <a
          href="#certifications"
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          <span data-lang-en>Certifications</span>
          <span data-lang-es style="display:none">Certificaciones</span>
        </a>
      </li>
      <li class="ml-4 flex items-center gap-2">
        <a
          href={siteConfig.cvPath}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 text-sm font-medium rounded-lg transition-colors duration-200 text-white"
          style={`background-color: ${siteConfig.accentColor}`}
        >
          <span data-lang-en>{siteConfig.en.downloadCV}</span>
          <span data-lang-es style="display:none">{siteConfig.es.downloadCV}</span>
        </a>
      </li>
      <li class="flex items-center gap-1">
        <button
          class="lang-btn px-2 py-1 text-xs font-medium rounded transition-colors duration-200 text-gray-500 hover:text-gray-800"
          data-lang="en"
        >
          EN
        </button>
        <span class="text-gray-300">|</span>
        <button
          class="lang-btn px-2 py-1 text-xs font-medium rounded transition-colors duration-200 text-gray-500 hover:text-gray-800"
          data-lang="es"
        >
          ES
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  window.addEventListener("scroll", () => {
    const header = document.getElementById("header");
    if (window.scrollY > 100) {
      header?.classList.add("bg-white/80", "backdrop-blur-sm");
    } else {
      header?.classList.remove("bg-white/80", "backdrop-blur-sm");
    }
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
  .lang-btn.active {
    color: #7c3aed;
    font-weight: 700;
  }
</style>
