---
import { siteConfig } from "../config";
---

<section id="certifications" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 2xl:grid-cols-12 gap-8 2xl:gap-16 items-start">
      <div class="2xl:col-span-4">
        <h2 class="text-2xl sm:text-3xl md:text-4xl 2xl:text-5xl font-bold text-gray-900">
          <span data-lang-en>{siteConfig.en.certificationsTitle}</span>
          <span data-lang-es style="display:none">{siteConfig.es.certificationsTitle}</span>
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        />
      </div>

      <div class="2xl:col-span-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-lang-en>
          {siteConfig.en.certifications.map((cert) => (
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 hover:shadow-md transition-shadow duration-300">
              <h3 class="text-base sm:text-lg font-semibold text-gray-900">{cert.name}</h3>
              <p class="text-sm mt-1" style={`color: ${siteConfig.accentColor}`}>{cert.issuer}</p>
              <span class="text-xs text-gray-500 mt-1 block">{cert.year}</span>
            </div>
          ))}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-lang-es style="display:none">
          {siteConfig.es.certifications.map((cert) => (
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 hover:shadow-md transition-shadow duration-300">
              <h3 class="text-base sm:text-lg font-semibold text-gray-900">{cert.name}</h3>
              <p class="text-sm mt-1" style={`color: ${siteConfig.accentColor}`}>{cert.issuer}</p>
              <span class="text-xs text-gray-500 mt-1 block">{cert.year}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
